#!name=WLOC 虚拟定位（内嵌版·纯本地）
#!desc=iOS 虚拟定位 - 纯本地直连，不需要任何服务器节点，开VPN就能用
#!homepage=https://github.com/chengsh2024/wloc-shortcut

[Script]
WLOC Response = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-,argument=mode=response&debug=false

WLOC Settings = type=http-request,pattern=^https?:\/\/gs-loc(?:-cn)?\.apple\.com\/wloc-settings\/,requires-body=0,max-size=0,timeout=10,script-

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

[Proxy]
# 本地直连代理，不需要任何远程服务器节点
DIRECT = direct

[Rule]
DOMAIN,gs-loc.apple.com,DIRECT
DOMAIN,gs-loc-cn.apple.com,DIRECT
DOMAIN,bluedot.is.autonavi.com,DIRECT
# 全局走本地直连，完全不经过任何远程服务器
FINAL,DIRECT
